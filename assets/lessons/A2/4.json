    "grammar_tips": [
      {
        "title": "Regular verbs in the past",
        "explanation": "Add -ed to regular verbs: play → played, visit → visited.",
        "explanation_translation": {
          "Hindi": "नियमित क्रियाओं में -ed जोड़ें: play → played, visit → visited.",
          "Japanese": "規則動詞は -ed をつけます: play → played, visit → visited."
        }
      },
      {
        "title": "Irregular verbs in the past",
        "explanation": "Irregular verbs change form: go → went, have → had, see → saw.",
        "explanation_translation": {
          "Hindi": "अनियमित क्रियाएँ रूप बदलती हैं: go → went, have → had, see → saw.",
          "Japanese": "不規則動詞は形が変わります: go → went, have → had, see → saw."
        }
      },
      {
        "title": "Negative sentences in past",
        "explanation": "Use 'did not' + base verb: I did not go. She did not play.",
        "explanation_translation": {
          "Hindi": "भूतकाल नकारात्मक वाक्यों में 'did not' + क्रिया का मूल रूप प्रयोग करें: I did not go. She did not play.",
          "Japanese": "過去の否定文では 'did not' + 動詞の原形を使います: I did not go. She did not play."
        }
      },
      {
        "title": "Questions in past",
        "explanation": "Use 'Did' + subject + base verb: Did you watch TV? Did she go?",
        "explanation_translation": {
          "Hindi": "भूतकाल प्रश्नों में 'Did' + subject + क्रिया का मूल रूप प्रयोग करें: Did you watch TV? Did she go?",
          "Japanese": "過去の疑問文では 'Did' + 主語 + 動詞の原形を使います: Did you watch TV? Did she go?"
        }
      }
    ]
  },
