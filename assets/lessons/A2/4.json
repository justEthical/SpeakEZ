      { "word": "walked", "meaning": "moved by putting one foot in front of the other" },
      { "word": "studied", "meaning": "learned about something" },
      { "word": "went", "meaning": "past of 'go', moved from one place to another" },
      { "word": "saw", "meaning": "past of 'see', looked at something" },
      { "word": "ate", "meaning": "past of 'eat', put food in your mouth and swallowed" },
      { "word": "had", "meaning": "past of 'have', owned or experienced something" },
      { "word": "bought", "meaning": "past of 'buy', got something by paying for it" }
    ],
    "grammar_tips": [
      {
        "title": "Simple Past - Regular Verbs",
        "explanation": "Add '-ed' to most verbs. Example: walk → walked, play → played."
      },
      {
        "title": "Simple Past - Irregular Verbs",
        "explanation": "Some verbs change completely. Example: go → went, see → saw."
      },
      {
        "title": "Making Negatives in Past",
        "explanation": "Use 'did not' + base verb. Example: I did not watch TV."
      }
    ],
    "example_sentences": [
