    "grammar_tips": [
      {
        "title": "Comparative adjectives",
        "explanation": "Use -er for short words. Example: tall → taller, fast → faster."
      },
      {
        "title": "Using 'than' for comparison",
        "explanation": "Use 'than' to compare. Example: He is taller than me."
      },
      {
        "title": "'More' and 'less' for long words",
        "explanation": "Use 'more' or 'less' for long adjectives. Example: more beautiful, less expensive."
      }
    ],
