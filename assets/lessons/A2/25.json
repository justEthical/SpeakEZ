{
  "id": "lesson_weather_climate_001",
  "lesson_name": "Describing Weather & Climate",
  "purpose": "All",
  "cefrLevel": "A2",
  "lesson_intro": {
    "vocabulary": [
      {
        "word": "sunny",
        "word_translation": {
          "Hindi": "धूप वाला",
          "Japanese": "晴れた"
        },
        "meaning": "When the sun is shining and the sky is clear",
        "meaning_translation": {
          "Hindi": "जब सूरज चमक रहा हो और आसमान साफ़ हो",
          "Japanese": "太陽が出ていて空が晴れているとき"
        },
        "examples": [
          {
            "sentence": "It is sunny today.",
            "translation": {
              "Hindi": "आज धूप है।",
              "Japanese": "今日は晴れです。"
            }
          }
        ]
      },
      {
        "word": "rainy",
        "word_translation": {
          "Hindi": "बरसात वाला",
          "Japanese": "雨の"
        },
        "meaning": "When it is raining",
        "meaning_translation": {
          "Hindi": "जब बारिश हो रही हो",
          "Japanese": "雨が降っているとき"
        },
        "examples": [
          {
            "sentence": "Yesterday was a rainy day.",
            "translation": {
              "Hindi": "कल बरसात का दिन था।",
              "Japanese": "昨日は雨の日でした。"
            }
          }
        ]
      },
      {
        "word": "cloudy",
        "word_translation": {
          "Hindi": "बादलों वाला",
          "Japanese": "曇り"
        },
        "meaning": "When the sky is full of clouds",
        "meaning_translation": {
          "Hindi": "जब आसमान बादलों से भरा हो",
          "Japanese": "空が雲でいっぱいのとき"
        },
        "examples": [
          {
            "sentence": "The sky is cloudy today.",
            "translation": {
              "Hindi": "आज आसमान बादलों से भरा है।",
              "Japanese": "今日は曇りです。"
            }
          }
        ]
      },
      {
        "word": "windy",
        "word_translation": {
          "Hindi": "हवादार",
          "Japanese": "風の強い"
        },
        "meaning": "When there is a lot of wind",
        "meaning_translation": {
          "Hindi": "जब बहुत हवा चल रही हो",
          "Japanese": "風が強いとき"
        },
        "examples": [
          {
            "sentence": "It is very windy outside.",
            "translation": {
              "Hindi": "बाहर बहुत हवा चल रही है।",
              "Japanese": "外はとても風が強いです。"
            }
          }
        ]
      },
      {
        "word": "storm",
        "word_translation": {
          "Hindi": "तूफ़ान",
          "Japanese": "嵐"
        },
        "meaning": "Strong wind with heavy rain or thunder",
        "meaning_translation": {
          "Hindi": "तेज़ हवा के साथ भारी बारिश या गरज",
          "Japanese": "強い風と大雨や雷を伴う天気"
        },
        "examples": [
          {
            "sentence": "A big storm is coming tonight.",
            "translation": {
              "Hindi": "आज रात एक बड़ा तूफ़ान आने वाला है।",
              "Japanese": "今夜大きな嵐が来ます。"
            }
          }
        ]
      },
      {
        "word": "snowy",
        "word_translation": {
          "Hindi": "बर्फ़ीला",
          "Japanese": "雪の"
        },
        "meaning": "When snow is falling",
        "meaning_translation": {
          "Hindi": "जब बर्फ गिर रही हो",
          "Japanese": "雪が降っているとき"
        },
        "examples": [
          {
            "sentence": "We stayed home on the snowy day.",
            "translation": {
              "Hindi": "हम बर्फ़ीले दिन घर पर रहे।",
              "Japanese": "雪の日に家にいました。"
            }
          }
        ]
      },
      {
        "word": "hot",
        "word_translation": {
          "Hindi": "गर्म",
          "Japanese": "暑い"
        },
        "meaning": "High temperature",
        "meaning_translation": {
          "Hindi": "जब तापमान ज़्यादा हो",
          "Japanese": "気温が高いとき"
        },
        "examples": [
          {
            "sentence": "It is hot in summer.",
            "translation": {
              "Hindi": "गर्मी में बहुत गर्मी होती है।",
              "Japanese": "夏は暑いです。"
            }
          }
        ]
      },
      {
        "word": "cold",
        "word_translation": {
          "Hindi": "ठंडा",
          "Japanese": "寒い"
        },
        "meaning": "Low temperature",
        "meaning_translation": {
          "Hindi": "जब तापमान कम हो",
          "Japanese": "気温が低いとき"
        },
        "examples": [
          {
            "sentence": "It is very cold in winter.",
            "translation": {
              "Hindi": "सर्दियों में बहुत ठंड होती है।",
              "Japanese": "冬はとても寒いです。"
            }
          }
        ]
      },
      {
        "word": "climate",
        "word_translation": {
          "Hindi": "जलवायु",
          "Japanese": "気候"
        },
        "meaning": "The usual weather of a place",
        "meaning_translation": {
          "Hindi": "किसी स्थान का सामान्य मौसम",
          "Japanese": "ある地域の一般的な天気"
        },
        "examples": [
          {
            "sentence": "India has a hot climate.",
            "translation": {
              "Hindi": "भारत की जलवायु गर्म है।",
              "Japanese": "インドは暑い気候です。"
            }
          }
        ]
      },
      {
        "word": "temperature",
        "word_translation": {
          "Hindi": "तापमान",
          "Japanese": "気温"
        },
        "meaning": "A measure of how hot or cold it is",
        "meaning_translation": {
          "Hindi": "यह माप कि कितना गर्म या ठंडा है",
          "Japanese": "暑さや寒さを示すもの"
        },
        "examples": [
          {
            "sentence": "The temperature is 30 degrees today.",
            "translation": {
              "Hindi": "आज तापमान 30 डिग्री है।",
              "Japanese": "今日は気温が30度です。"
            }
          }
        ]
      },
      {
        "word": "humid",
        "word_translation": {
          "Hindi": "नम",
          "Japanese": "湿気の多い"
        },
        "meaning": "When the air has a lot of moisture",
        "meaning_translation": {
          "Hindi": "जब हवा में बहुत नमी हो",
          "Japanese": "空気に湿気が多いとき"
        },
        "examples": [
          {
            "sentence": "It feels humid during the rainy season.",
            "translation": {
              "Hindi": "बरसात के मौसम में नमी रहती है।",
              "Japanese": "雨季は湿気があります。"
            }
          }
        ]
      }
    ],
    "grammar_tips": [
      {
        "title": "Using 'It is' for weather",
        "explanation": "We use 'It is' to describe weather. Example: It is sunny. It is cold.",
        "explanation_translation": {
          "Hindi": "हम मौसम का वर्णन करने के लिए 'It is' का उपयोग करते हैं। उदाहरण: It is sunny. It is cold.",
          "Japanese": "天気を表すとき「It is」を使います。例: It is sunny. It is cold."
        }
      },
      {
        "title": "Asking about weather",
        "explanation": "Say 'What is the weather like?' to ask. Example: What is the weather like today?",
        "explanation_translation": {
          "Hindi": "मौसम पूछने के लिए कहें 'What is the weather like?'। उदाहरण: What is the weather like today?",
          "Japanese": "天気を尋ねるとき「What is the weather like?」を使います。例: What is the weather like today?"
        }
      }
    ]
  },
