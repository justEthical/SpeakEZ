    "grammar_tips": [
      {
        "title": "Using 'is' and 'are' with adjectives",
        "explanation": "Use 'is' for one person and 'are' for many. Example: She is polite. They are hardworking."
      },
      {
        "title": "Describing yourself and others",
        "explanation": "Use 'I am', 'He is', 'She is', 'They are' + adjective. Example: I am honest."
      }
    ],
