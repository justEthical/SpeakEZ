{
  "id": "lesson_giving_following_instructions_001",
  "lesson_name": "Giving & Following Instructions",
  "purpose": "All",
  "cefrLevel": "A2",
  "lesson_intro": {
    "vocabulary": [
      {
        "word": "First",
        "word_translation": {
          "Hindi": "सबसे पहले",
          "Japanese": "最初に"
        },
        "meaning": "Used to begin a list of steps",
        "meaning_translation": {
          "Hindi": "किसी क्रम की शुरुआत करने के लिए प्रयोग होता है",
          "Japanese": "手順の最初に使われる"
        },
        "examples": [
          {
            "sentence": "First, open the box.",
            "translation": {
              "Hindi": "सबसे पहले, डिब्बा खोलें।",
              "Japanese": "最初に箱を開けてください。"
            }
          }
        ]
      },
      {
        "word": "Next",
        "word_translation": {
          "Hindi": "फिर",
          "Japanese": "次に"
        },
        "meaning": "Used to describe the following step",
        "meaning_translation": {
          "Hindi": "अगले चरण को बताने के लिए प्रयोग होता है",
          "Japanese": "次のステップを示す"
        },
        "examples": [
          {
            "sentence": "Next, plug in the cable.",
            "translation": {
              "Hindi": "फिर केबल लगाएं।",
              "Japanese": "次にケーブルを差し込んでください。"
            }
          }
        ]
      },
      {
        "word": "Then",
        "word_translation": {
          "Hindi": "फिर",
          "Japanese": "それから"
        },
        "meaning": "Used to indicate the next step in sequence",
        "meaning_translation": {
          "Hindi": "क्रम में अगला कदम दर्शाने के लिए",
          "Japanese": "次のステップを表す"
        },
        "examples": [
          {
            "sentence": "Then, press the power button.",
            "translation": {
              "Hindi": "फिर, पावर बटन दबाएं।",
              "Japanese": "それから電源ボタンを押してください。"
            }
          }
        ]
      },
      {
        "word": "Finally",
        "word_translation": {
          "Hindi": "अंत में",
          "Japanese": "最後に"
        },
        "meaning": "Used to indicate the last step",
        "meaning_translation": {
          "Hindi": "अंतिम चरण को बताने के लिए",
          "Japanese": "最後のステップを示す"
        },
        "examples": [
          {
            "sentence": "Finally, restart the system.",
            "translation": {
              "Hindi": "अंत में, सिस्टम को पुनः चालू करें।",
              "Japanese": "最後にシステムを再起動してください。"
            }
          }
        ]
      },
      {
        "word": "Carefully",
        "word_translation": {
          "Hindi": "सावधानी से",
          "Japanese": "慎重に"
        },
        "meaning": "With great attention to detail",
        "meaning_translation": {
          "Hindi": "ध्यानपूर्वक या सावधानी से",
          "Japanese": "注意深く"
        },
        "examples": [
          {
            "sentence": "Carefully cut the paper.",
            "translation": {
              "Hindi": "सावधानी से कागज काटें।",
              "Japanese": "慎重に紙を切ってください。"
            }
          }
        ]
      },
      {
        "word": "Turn on",
        "word_translation": {
          "Hindi": "चालू करें",
          "Japanese": "電源を入れる"
        },
        "meaning": "To start a machine or device",
        "meaning_translation": {
          "Hindi": "किसी यंत्र या उपकरण को चालू करना",
          "Japanese": "機械や装置を動かす"
        },
        "examples": [
          {
            "sentence": "Turn on the fan.",
            "translation": {
              "Hindi": "पंखा चालू करें।",
              "Japanese": "扇風機をつけてください。"
            }
          }
        ]
      },
      {
        "word": "Press",
        "word_translation": {
          "Hindi": "दबाएं",
          "Japanese": "押す"
        },
        "meaning": "To push something gently",
        "meaning_translation": {
          "Hindi": "हल्के से किसी चीज को दबाना",
          "Japanese": "軽く押す"
        },
        "examples": [
          {
            "sentence": "Press the red button.",
            "translation": {
              "Hindi": "लाल बटन दबाएं।",
              "Japanese": "赤いボタンを押してください。"
            }
          }
        ]
      }
    ],
    "grammar_tips": [
      {
        "title": "Imperative Sentences",
        "explanation": "Instructions often use imperative sentences that start with a verb.",
        "explanation_translation": {
          "Hindi": "निर्देशों में अक्सर क्रिया से शुरू होने वाले वाक्य होते हैं।",
          "Japanese": "命令文は動詞から始まることが多いです。"
        }
      },
      {
        "title": "Sequencing Words",
        "explanation": "Words like 'first', 'next', 'then', and 'finally' help organize instructions clearly.",
        "explanation_translation": {
          "Hindi": "'First', 'Next', 'Then', 'Finally' जैसे शब्द निर्देशों को क्रम में रखने में मदद करते हैं।",
          "Japanese": "「First」「Next」「Then」「Finally」などの語は順序を明確にします。"
        }
      }
    ]
  },
