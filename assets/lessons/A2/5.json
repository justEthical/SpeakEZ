  "purpose": "All",
  "cefrLevel": "A2",
  "lesson_intro": {
    "vocabulary": [
      { "word": "plan", "meaning": "an idea for what you will do" },
      { "word": "future", "meaning": "the time after now" },
      { "word": "travel", "meaning": "to go to a new place" },
      { "word": "meet", "meaning": "to see someone by arrangement" },
      { "word": "study", "meaning": "to learn something" },
      { "word": "visit", "meaning": "to go to see a person or place" },
      { "word": "next", "meaning": "coming immediately after" },
      { "word": "weekend", "meaning": "Saturday and Sunday" },
      { "word": "decide", "meaning": "to make a choice" },
      { "word": "save", "meaning": "to keep money for later" }
    ],
    "grammar_tips": [
      {
        "title": "Using 'going to' for plans",
        "explanation": "Use 'going to' for something you have decided to do. Example: I am going to study."
      },
      {
        "title": "Using 'will' for offers and decisions",
        "explanation": "Use 'will' for sudden decisions or offers. Example: I will help you."
      }
    ],
    "example_sentences": [
      { "sentence": "I am going to visit my cousin next week.", "translation": "" },
      { "sentence": "She will call you tomorrow.", "translation": "" },
      { "sentence": "We are going to travel to Delhi.", "translation": "" },
      { "sentence": "I will save money for a new phone.", "translation": "" }
    ]
  },
