      { "word": "nervous", "meaning": "feeling worried or afraid" },
      { "word": "bored", "meaning": "feeling tired because something is not interesting" },
      { "word": "surprised", "meaning": "feeling something unexpected happened" },
      { "word": "tired", "meaning": "feeling you need to rest" },
      { "word": "scared", "meaning": "feeling afraid" },
      { "word": "proud", "meaning": "feeling good about what you or someone has done" }
    ],
    "grammar_tips": [
      {
        "title": "Using 'feel' and 'am/is/are'",
        "explanation": "Use 'I feel' or 'I am' to talk about your feelings. Example: I feel happy. I am sad."
      },
      {
        "title": "Expressing emotions about others",
        "explanation": "Use 'He/She is' or 'They are' for others. Example: She is excited. They are bored."
      }
    ],
