    "grammar_tips": [
      {
        "title": "Asking for Personal Details",
        "explanation": "Use 'What is your...?' to ask for details. Example: What is your email?",
        "explanation_translation": {
          "Hindi": "'What is your...?' का उपयोग जानकारी पूछने के लिए करें। उदाहरण: What is your email?",
          "Japanese": "「What is your...?」を使って個人情報を尋ねます。例: What is your email?"
        }
      },
      {
        "title": "Answering About Yourself",
        "explanation": "Use 'My' or 'I am' to answer. Example: My surname is Khan. I am Indian.",
        "explanation_translation": {
          "Hindi": "'My' या 'I am' का उपयोग उत्तर देने के लिए करें। उदाहरण: My surname is Khan. I am Indian.",
          "Japanese": "「My」や「I am」を使って答えます。例: My surname is Khan. I am Indian."
        }
      },
      {
        "title": "Using 'be' vs 'have'",
        "explanation": "Use 'I am' for nationality, age, and marital status. Use 'I have' for possessions. Example: I am 25. I have a passport.",
        "explanation_translation": {
          "Hindi": "'I am' का उपयोग राष्ट्रीयता, उम्र और वैवाहिक स्थिति के लिए करें। 'I have' का उपयोग वस्तुओं के लिए करें। उदाहरण: I am 25. I have a passport.",
          "Japanese": "「I am」は国籍・年齢・結婚の状態に使います。「I have」は持ち物に使います。例: I am 25. I have a passport."
        }
      },
      {
        "title": "Short Answers",
        "explanation": "When asked yes/no questions, use short answers. Example: Are you married? Yes, I am. / No, I am not.",
        "explanation_translation": {
          "Hindi": "हाँ/ना के प्रश्नों में छोटे उत्तर दें। उदाहरण: Are you married? Yes, I am. / No, I am not.",
          "Japanese": "はい/いいえの質問には短い答えを使います。例: Are you married? Yes, I am. / No, I am not."
        }
      }
    ]
  },
