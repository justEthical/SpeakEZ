  "lesson_intro": {
    "vocabulary": [
      { "word": "experience", "meaning": "something you did or felt" },
      { "word": "ever", "meaning": "at any time in your life" },
      { "word": "never", "meaning": "not at any time" },
      { "word": "try", "meaning": "to do something for the first time" },
      { "word": "visit", "meaning": "to go and see a place or person" },
      { "word": "travel", "meaning": "to go to another place" },
      { "word": "eat", "meaning": "to put food in your mouth and swallow" },
      { "word": "see", "meaning": "to look at something" },
      { "word": "meet", "meaning": "to see someone for the first time" },
      { "word": "enjoy", "meaning": "to like doing something" }
    ],
    "grammar_tips": [
      {
        "title": "Using 'have you ever...?'",
        "explanation": "Use 'Have you ever' + past participle to ask about experiences. Example: Have you ever visited Delhi?"
      },
      {
        "title": "Talking about things you have never done",
        "explanation": "Use 'I have never' + past participle. Example: I have never eaten sushi."
      }
    ],
    "example_sentences": [
      { "sentence": "Have you ever visited another country?", "translation": "" },
      { "sentence": "I have never tried Italian food.", "translation": "" },
      { "sentence": "She has met many famous people.", "translation": "" },
      { "sentence": "We have seen that movie twice.", "translation": "" }
    ]
  },
