    "vocabulary": [
      { "word": "house", "meaning": "a place where you live" },
      { "word": "home", "meaning": "the place you live with your family" },
      { "word": "room", "meaning": "a part of a house" },
      { "word": "kitchen", "meaning": "the room where you cook food" },
      { "word": "bedroom", "meaning": "the room where you sleep" },
      { "word": "bathroom", "meaning": "the room where you wash" },
      { "word": "living room", "meaning": "the room where you sit and talk" },
      { "word": "garden", "meaning": "an area with plants near your house" },
      { "word": "window", "meaning": "an opening in the wall to let in light" },
      { "word": "door", "meaning": "the part you open to go in or out" }
    ],
    "grammar_tips": [
      {
        "title": "Using 'There is/There are'",
        "explanation": "Use 'There is' for one thing and 'There are' for many. Example: There is a kitchen. There are two windows."
      },
      {
        "title": "Using 'my' for things you have",
        "explanation": "Use 'my' to talk about your house. Example: My house is big. My room is blue."
      }
    ],
    "example_sentences": [
      { "sentence": "My house has three rooms.", "translation": "मेरे घर में तीन कमरे हैं।" },
      { "sentence": "There is a kitchen in my house.", "translation": "मेरे घर में एक रसोईघर है।" },
      { "sentence": "The bathroom is small.", "translation": "बाथरूम छोटा है।" },
      { "sentence": "We sit in the living room.", "translation": "हम बैठक कक्ष में बैठते हैं।" }
    ]
