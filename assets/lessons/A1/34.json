{
  "id": "lesson_body_health_001",
  "lesson_name": "My Body & Health",
  "purpose": "All",
  "cefrLevel": "A1",
  "lesson_intro": {
    "vocabulary": [
      {
        "word": "body",
        "word_translation": {
          "Hindi": "शरीर",
          "Japanese": "体"
        },
        "meaning": "all the parts that make a person or animal",
        "meaning_translation": {
          "Hindi": "व्यक्ति या जानवर के सभी हिस्से",
          "Japanese": "人や動物のすべての部分"
        },
        "examples": [
          {
            "sentence": "My body is healthy.",
            "translation": {
              "Hindi": "मेरा शरीर स्वस्थ है।",
              "Japanese": "私の体は健康です。"
            }
          }
        ]
      },
      {
        "word": "head",
        "word_translation": {
          "Hindi": "सिर",
          "Japanese": "頭"
        },
        "meaning": "the top part of your body with your eyes, ears, nose, and mouth",
        "meaning_translation": {
          "Hindi": "शरीर का ऊपरी हिस्सा, जिसमें आंखें, कान, नाक और मुँह होते हैं",
          "Japanese": "目・耳・鼻・口がある体の上の部分"
        },
        "examples": [
          {
            "sentence": "She has a headache.",
            "translation": {
              "Hindi": "उसके सिर में दर्द है।",
              "Japanese": "彼女は頭が痛いです。"
            }
          }
        ]
      },
      {
        "word": "hand",
        "word_translation": {
          "Hindi": "हाथ",
          "Japanese": "手"
        },
        "meaning": "the part at the end of your arm for holding things",
        "meaning_translation": {
          "Hindi": "बांह का वह हिस्सा जिससे आप चीज़ें पकड़ते हैं",
          "Japanese": "物を持つための腕の先の部分"
        },
        "examples": [
          {
            "sentence": "He raises his hand.",
            "translation": {
              "Hindi": "वह अपना हाथ उठाता है।",
              "Japanese": "彼は手を挙げます。"
            }
          }
        ]
      },
      {
        "word": "leg",
        "word_translation": {
          "Hindi": "पैर",
          "Japanese": "足"
        },
        "meaning": "the part of your body you use to walk and run",
        "meaning_translation": {
          "Hindi": "शरीर का वह हिस्सा जिससे आप चलते और दौड़ते हैं",
          "Japanese": "歩いたり走ったりする体の部分"
        },
        "examples": [
          {
            "sentence": "He has long legs.",
            "translation": {
              "Hindi": "उसके पैर लंबे हैं।",
              "Japanese": "彼は足が長いです。"
            }
          }
        ]
      },
      {
        "word": "eye",
        "word_translation": {
          "Hindi": "आँख",
          "Japanese": "目"
        },
        "meaning": "the part you use to see",
        "meaning_translation": {
          "Hindi": "जिससे आप देख सकते हैं",
          "Japanese": "見るための部分"
        },
        "examples": [
          {
            "sentence": "She has blue eyes.",
            "translation": {
              "Hindi": "उसकी आँखें नीली हैं।",
              "Japanese": "彼女の目は青いです。"
            }
          }
        ]
      },
      {
        "word": "mouth",
        "word_translation": {
          "Hindi": "मुँह",
          "Japanese": "口"
        },
        "meaning": "the part of your face you use to eat and speak",
        "meaning_translation": {
          "Hindi": "चेहरे का वह हिस्सा जिससे आप खाते और बोलते हैं",
          "Japanese": "食べたり話したりする顔の部分"
        },
        "examples": [
          {
            "sentence": "Open your mouth, please.",
            "translation": {
              "Hindi": "कृपया अपना मुँह खोलें।",
              "Japanese": "口を開けてください。"
            }
          }
        ]
      },
      {
        "word": "ear",
        "word_translation": {
          "Hindi": "कान",
          "Japanese": "耳"
        },
        "meaning": "the part you use to hear",
        "meaning_translation": {
          "Hindi": "जिससे आप सुन सकते हैं",
          "Japanese": "聞くための部分"
        },
        "examples": [
          {
            "sentence": "He has small ears.",
            "translation": {
              "Hindi": "उसके कान छोटे हैं।",
              "Japanese": "彼は耳が小さいです。"
            }
          }
        ]
      },
      {
        "word": "nose",
        "word_translation": {
          "Hindi": "नाक",
          "Japanese": "鼻"
        },
        "meaning": "the part of your face you use to smell and breathe",
        "meaning_translation": {
          "Hindi": "चेहरे का वह हिस्सा जिससे आप सूँघते और सांस लेते हैं",
          "Japanese": "においをかいだり息をしたりする顔の部分"
        },
        "examples": [
          {
            "sentence": "She touches her nose.",
            "translation": {
              "Hindi": "वह अपनी नाक छूती है।",
              "Japanese": "彼女は鼻に触ります。"
            }
          }
        ]
      },
      {
        "word": "healthy",
        "word_translation": {
          "Hindi": "स्वस्थ",
          "Japanese": "健康な"
        },
        "meaning": "feeling well and not sick",
        "meaning_translation": {
          "Hindi": "अच्छा महसूस करना, बीमार न होना",
          "Japanese": "元気で病気でないこと"
        },
        "examples": [
          {
            "sentence": "He eats fruits to stay healthy.",
            "translation": {
              "Hindi": "वह स्वस्थ रहने के लिए फल खाता है।",
              "Japanese": "彼は健康のために果物を食べます。"
            }
          }
        ]
      },
      {
        "word": "sick",
        "word_translation": {
          "Hindi": "बीमार",
          "Japanese": "病気"
        },
        "meaning": "not feeling well",
        "meaning_translation": {
          "Hindi": "अच्छा महसूस न होना",
          "Japanese": "元気でないこと"
        },
        "examples": [
          {
            "sentence": "She is sick today.",
            "translation": {
              "Hindi": "वह आज बीमार है।",
              "Japanese": "彼女は今日病気です。"
            }
          }
        ]
      }
    ],
    "grammar_tips": [
      {
        "title": "Talking about body parts",
        "explanation": "Use 'my', 'your', etc.: 'My head hurts.' 'Wash your hands.'",
        "explanation_translation": {
          "Hindi": "शरीर के हिस्सों के लिए 'my', 'your' आदि का उपयोग करें: 'My head hurts.' 'Wash your hands.'",
          "Japanese": "体の部分について話す時「my」「your」などを使います。「My head hurts.」「Wash your hands.」"
        }
      },
      {
        "title": "Describing health",
        "explanation": "Say 'I am healthy.' or 'She is sick.'",
        "explanation_translation": {
          "Hindi": "'I am healthy.' या 'She is sick.' का प्रयोग करें।",
          "Japanese": "健康については「I am healthy.」「She is sick.」と言います。"
        }
      }
    ]
  },
