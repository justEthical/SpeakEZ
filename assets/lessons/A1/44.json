        "examples": [
          {
            "sentence": "He slept early yesterday.",
            "translation": {
              "Hindi": "वह कल जल्दी सो गया।",
              "Japanese": "彼は昨日早く寝ました。"
            }
          }
        ]
      }
    ],
    "grammar_tips": [
      {
        "title": "How to form the simple past",
        "explanation": "For regular verbs, add -ed: 'play' → 'played'. Irregular verbs change form: 'go' → 'went'.",
        "explanation_translation": {
          "Hindi": "Regular verbs में -ed जोड़ें: 'play' → 'played'. Irregular verbs का रूप बदलता है: 'go' → 'went'.",
          "Japanese": "規則動詞は-edを付ける：「play」→「played」。不規則動詞は形が変わる：「go」→「went」。"
        }
      },
      {
        "title": "Making past tense questions",
        "explanation": "Use 'Did' + base verb: 'Did you see her?'",
        "explanation_translation": {
          "Hindi": "Past tense में सवाल के लिए 'Did' + base verb लगाएं: 'Did you see her?'",
          "Japanese": "過去形の質問には「Did」+ 動詞の原形を使う：「Did you see her?」"
        }
      }
    ]
  },
