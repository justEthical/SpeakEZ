        "examples": [
          {
            "sentence": "We visited our grandparents.",
            "translation": {
              "Hindi": "हम दादा-दादी से मिलने गए।",
              "Japanese": "私たちは祖父母を訪ねました。"
            }
          }
        ]
      },
      {
        "word": "watched",
        "word_translation": {
          "Hindi": "देखा",
          "Japanese": "見た"
        },
        "meaning": "looked at something for a period of time",
        "meaning_translation": {
          "Hindi": "किसी चीज़ को ध्यान से देखा",
          "Japanese": "何かをじっと見た"
        },
        "examples": [
          {
            "sentence": "We watched TV last night.",
            "translation": {
              "Hindi": "हमने कल रात टीवी देखा।",
              "Japanese": "私たちは昨夜テレビを見ました。"
            }
          }
        ]
      },
      {
        "word": "slept",
        "word_translation": {
          "Hindi": "सोया",
          "Japanese": "寝た"
        },
        "meaning": "past of 'sleep'; to have rested with eyes closed",
        "meaning_translation": {
          "Hindi": "'Sleep' का भूतकाल; सोया",
          "Japanese": "「sleep」の過去形、寝た"
