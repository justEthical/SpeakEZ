  "lesson_intro": {
    "vocabulary": [
      {
        "word": "went",
        "word_translation": {
          "Hindi": "गया/गई",
          "Japanese": "行った"
        },
        "meaning": "past of 'go'; to have gone somewhere",
        "meaning_translation": {
          "Hindi": "'Go' का भूतकाल; कहीं गया",
          "Japanese": "「go」の過去形、どこかに行った"
        },
        "examples": [
          {
            "sentence": "I went to the market.",
            "translation": {
              "Hindi": "मैं बाजार गया।",
              "Japanese": "私は市場に行きました。"
            }
          }
        ]
      },
      {
        "word": "saw",
        "word_translation": {
          "Hindi": "देखा",
          "Japanese": "見た"
        },
        "meaning": "past of 'see'; to have looked at something",
        "meaning_translation": {
          "Hindi": "'See' का भूतकाल; कुछ देखा",
          "Japanese": "「see」の過去形、何かを見た"
        },
        "examples": [
          {
            "sentence": "She saw a movie yesterday.",
            "translation": {
              "Hindi": "उसने कल एक फिल्म देखी।",
              "Japanese": "彼女は昨日映画を見ました。"
            }
          }
        ]
      },
      {
        "word": "ate",
        "word_translation": {
          "Hindi": "खाया",
          "Japanese": "食べた"
        },
        "meaning": "past of 'eat'; to have eaten something",
        "meaning_translation": {
          "Hindi": "'Eat' का भूतकाल; कुछ खाया",
          "Japanese": "「eat」の過去形、何かを食べた"
        },
        "examples": [
          {
            "sentence": "We ate lunch at 1 PM.",
            "translation": {
              "Hindi": "हमने 1 बजे दोपहर का खाना खाया।",
              "Japanese": "私たちは1時に昼ご飯を食べました。"
            }
          }
        ]
      },
      {
        "word": "had",
        "word_translation": {
          "Hindi": "था/थी/थे",
          "Japanese": "持っていた"
        },
        "meaning": "past of 'have'; to have possessed or experienced",
        "meaning_translation": {
          "Hindi": "'Have' का भूतकाल; पास था या अनुभव किया",
          "Japanese": "「have」の過去形、持っていた・経験した"
        },
        "examples": [
          {
            "sentence": "He had a dog when he was young.",
            "translation": {
              "Hindi": "जब वह छोटा था उसके पास एक कुत्ता था।",
              "Japanese": "彼は小さい時犬を飼っていました。"
            }
          }
        ]
      },
      {
        "word": "played",
        "word_translation": {
          "Hindi": "खेला",
          "Japanese": "遊んだ／演奏した"
        },
