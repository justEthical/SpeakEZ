            }
          }
        ]
      },
      {
        "word": "visited",
        "word_translation": {
          "Hindi": "मुलाकात की / गया",
          "Japanese": "訪ねた"
        },
        "meaning": "went to see a person or place",
        "meaning_translation": {
          "Hindi": "किसी से मिलने या जगह देखने गया",
          "Japanese": "人や場所を訪ねた"
