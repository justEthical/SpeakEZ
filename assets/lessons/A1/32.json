    "grammar_tips": [
      {
        "title": "Talking about nationality",
        "explanation": "Use 'I am Indian.' or 'He is Japanese.' to tell someone’s nationality.",
        "explanation_translation": {
          "Hindi": "'I am Indian.' या 'He is Japanese.' का प्रयोग राष्ट्रीयता बताने के लिए करें।",
          "Japanese": "国籍を話す時は「I am Indian.」「He is Japanese.」を使います。"
        }
      },
      {
        "title": "Asking about country",
        "explanation": "Say 'Where are you from?' or 'What is your nationality?'",
        "explanation_translation": {
          "Hindi": "'Where are you from?' या 'What is your nationality?' कहें।",
          "Japanese": "「Where are you from?」「What is your nationality?」と言います。"
        }
      }
