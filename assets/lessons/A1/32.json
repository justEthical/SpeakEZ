      {
        "word": "country",
        "word_translation": {
          "Hindi": "देश",
          "Japanese": "国"
        },
        "meaning": "an area of land with its own people and government",
        "meaning_translation": {
          "Hindi": "अपनी जनता और सरकार वाला क्षेत्र",
          "Japanese": "自分の国民と政府を持つ土地"
        },
        "examples": [
          {
            "sentence": "India is a big country.",
            "translation": {
              "Hindi": "भारत एक बड़ा देश है।",
              "Japanese": "インドは大きな国です。"
            }
          }
        ]
      },
