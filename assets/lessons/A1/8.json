{
  "id": "lesson_classroom_objects_001",
  "lesson_name": "Classroom Objects",
  "purpose": "All",
  "cefrLevel": "A1",
  "lesson_intro": {
    "vocabulary": [
      { "word": "desk", "meaning": "a table you sit at in class" },
      { "word": "chair", "meaning": "something you sit on" },
      { "word": "book", "meaning": "something you read" },
      { "word": "pen", "meaning": "something you write with (ink)" },
      { "word": "pencil", "meaning": "something you write with (lead)" },
      { "word": "eraser", "meaning": "something you use to remove pencil marks" },
      { "word": "board", "meaning": "a big surface for writing in class" },
      { "word": "teacher", "meaning": "the person who teaches the class" },
      { "word": "bag", "meaning": "something you carry your things in" },
      { "word": "notebook", "meaning": "a book for writing notes" }
    ],
    "grammar_tips": [
      {
        "title": "Using 'a' and 'an' with objects",
        "explanation": "Use 'a' before words starting with a consonant sound. Example: a pen, a book."
      },
      {
        "title": "This is/These are",
        "explanation": "Use 'This is' for one object and 'These are' for many. Example: This is a chair. These are books."
      }
    ],
    "example_sentences": [
      { "sentence": "This is my desk.", "translation": "यह मेरी मेज़ है।" },
      { "sentence": "I have a blue pen.", "translation": "मेरे पास एक नीला पेन है।" },
      { "sentence": "The teacher writes on the board.", "translation": "शिक्षक बोर्ड पर लिखते हैं।" },
      { "sentence": "There are many books in my bag.", "translation": "मेरे बैग में कई किताबें हैं।" }
    ]
  },
