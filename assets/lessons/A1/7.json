    "grammar_tips": [
      {
        "title": "Adjectives before nouns",
        "explanation": "Put color words before the thing. Example: red apple, blue sky.",
        "explanation_translation": {
          "Hindi": "रंग के शब्द हमेशा वस्तु से पहले आते हैं। उदाहरण: लाल सेब, नीला आकाश।",
          "Japanese": "色の単語は名詞の前に置きます。例：赤いりんご、青い空。"
        }
      },
      {
        "title": "Using 'is' for color",
        "explanation": "Use 'is' to tell the color of one thing. Example: The apple is red.",
        "explanation_translation": {
          "Hindi": "किसी एक चीज़ का रंग बताने के लिए 'is' का प्रयोग करें। उदाहरण: The apple is red.",
          "Japanese": "1つの物の色を言う時は「is」を使います。例：The apple is red."
        }
      }
    ]
  },
