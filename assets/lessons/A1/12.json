  "lesson_intro": {
    "vocabulary": [
      {
        "word": "shirt",
        "word_translation": {
          "Hindi": "कमीज़",
          "Japanese": "シャツ"
        },
        "meaning": "A piece of clothing worn on the upper body",
        "meaning_translation": {
          "Hindi": "ऊपरी शरीर पर पहना जाने वाला वस्त्र",
          "Japanese": "上半身に着る服"
        },
        "examples": [
          {
            "sentence": "I am wearing a blue shirt.",
            "translation": {
              "Hindi": "मैं नीली कमीज़ पहन रहा हूँ।",
              "Japanese": "私は青いシャツを着ています。"
            }
          }
        ]
      },
      {
        "word": "pants",
        "word_translation": {
          "Hindi": "पतलून",
          "Japanese": "ズボン"
        },
        "meaning": "Clothes worn on the legs",
        "meaning_translation": {
          "Hindi": "पैरों पर पहने जाने वाले कपड़े",
          "Japanese": "足に履く服"
        },
        "examples": [
          {
            "sentence": "He bought black pants.",
            "translation": {
              "Hindi": "उसने काली पतलून खरीदी।",
              "Japanese": "彼は黒いズボンを買いました。"
            }
          }
        ]
      },
      {
        "word": "shoes",
        "word_translation": {
          "Hindi": "जूते",
          "Japanese": "靴"
        },
        "meaning": "Something you wear on your feet",
        "meaning_translation": {
          "Hindi": "पैरों में पहनी जाने वाली वस्तु",
          "Japanese": "足に履くもの"
        },
        "examples": [
          {
            "sentence": "My shoes are white.",
            "translation": {
              "Hindi": "मेरे जूते सफेद हैं।",
              "Japanese": "私の靴は白です。"
            }
          }
        ]
      },
      {
        "word": "hat",
        "word_translation": {
          "Hindi": "टोपी",
          "Japanese": "帽子"
        },
        "meaning": "Something you wear on your head",
        "meaning_translation": {
          "Hindi": "सिर पर पहनी जाने वाली वस्तु",
          "Japanese": "頭にかぶるもの"
        },
        "examples": [
          {
            "sentence": "She is wearing a red hat.",
            "translation": {
              "Hindi": "वह लाल टोपी पहन रही है।",
              "Japanese": "彼女は赤い帽子をかぶっています。"
            }
          }
        ]
      },
      {
        "word": "bag",
        "word_translation": {
          "Hindi": "बैग",
          "Japanese": "かばん"
        },
        "meaning": "Something used to carry things",
        "meaning_translation": {
          "Hindi": "चीज़ें रखने और ले जाने के लिए उपयोग की जाने वाली वस्तु",
          "Japanese": "物を持ち運ぶために使うもの"
        },
        "examples": [
          {
            "sentence": "This is my school bag.",
            "translation": {
              "Hindi": "यह मेरा स्कूल बैग है।",
              "Japanese": "これは私の学校のかばんです。"
            }
          }
        ]
      }
    ],
    "grammar_tips": [
      {
        "title": "Using 'wearing'",
        "explanation": "Use 'I am wearing...' to say what clothes you have on. Example: I am wearing a shirt.",
        "explanation_translation": {
          "Hindi": "'I am wearing...' का उपयोग यह बताने के लिए करें कि आप कौन से कपड़े पहने हुए हैं। उदाहरण: I am wearing a shirt.",
          "Japanese": "「I am wearing...」を使って、着ている服を言います。例: I am wearing a shirt."
        }
      },
      {
        "title": "Using colors with clothes",
        "explanation": "Say the color before the clothing word. Example: a red hat, blue pants.",
        "explanation_translation": {
          "Hindi": "कपड़ों से पहले रंग का प्रयोग करें। उदाहरण: a red hat, blue pants.",
          "Japanese": "服の前に色を言います。例: a red hat, blue pants."
        }
      }
    ]
  },
