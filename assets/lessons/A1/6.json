    "grammar_tips": [
      {
        "title": "Using 'is' and 'has'",
        "explanation": "Use 'is' for describing, 'has' for features. Example: She is tall. She has long hair."
      },
      {
        "title": "Adjectives before nouns",
        "explanation": "Put adjectives before nouns. Example: big eyes, short hair."
      }
