  "lesson_intro": {
    "vocabulary": [
      {
        "word": "tall",
        "word_translation": { "Hindi": "लंबा", "Japanese": "背が高い" },
        "meaning": "Having a greater than average height.",
        "meaning_translation": { "Hindi": "औसत से अधिक लंबाई वाला।", "Japanese": "平均より背が高いこと。" },
        "examples": [
          {
            "sentence": "He is tall and young.",
            "translation": { "Hindi": "वह लंबा और जवान है।", "Japanese": "彼は背が高くて若いです。" }
          }
        ]
      },
      {
        "word": "short",
        "word_translation": { "Hindi": "छोटा", "Japanese": "背が低い" },
        "meaning": "Having a smaller than average height.",
        "meaning_translation": { "Hindi": "औसत से कम लंबाई वाला।", "Japanese": "平均より背が低いこと。" },
        "examples": [
          {
            "sentence": "My brother is short.",
            "translation": { "Hindi": "मेरा भाई छोटा है।", "Japanese": "私の弟（兄）は背が低いです。" }
          }
        ]
      },
      {
        "word": "young",
        "word_translation": { "Hindi": "जवान", "Japanese": "若い" },
        "meaning": "Not old. Having lived for only a few years.",
        "meaning_translation": { "Hindi": "बूढ़ा नहीं। कुछ ही वर्षों से जीवित।", "Japanese": "年をとっていない。まだ若い。" },
        "examples": [
          {
            "sentence": "The boy is young.",
            "translation": { "Hindi": "लड़का जवान है।", "Japanese": "その男の子は若いです。" }
          }
        ]
      },
      {
        "word": "old",
        "word_translation": { "Hindi": "बूढ़ा", "Japanese": "年をとっている" },
        "meaning": "Having lived for many years.",
        "meaning_translation": { "Hindi": "कई वर्षों तक जीवित रहे।", "Japanese": "長い間生きてきた。" },
        "examples": [
          {
            "sentence": "My grandmother is old.",
            "translation": { "Hindi": "मेरी दादी बूढ़ी हैं।", "Japanese": "私の祖母は年をとっています。" }
          }
        ]
      },
      {
        "word": "hair",
        "word_translation": { "Hindi": "बाल", "Japanese": "髪" },
        "meaning": "What grows on your head.",
        "meaning_translation": { "Hindi": "जो आपके सिर पर उगते हैं।", "Japanese": "頭に生えているもの。" },
        "examples": [
          {
            "sentence": "She has long hair.",
            "translation": { "Hindi": "उसके लंबे बाल हैं।", "Japanese": "彼女は髪が長いです。" }
          }
        ]
      },
      {
        "word": "eyes",
        "word_translation": { "Hindi": "आंखें", "Japanese": "目" },
        "meaning": "What you use to see.",
        "meaning_translation": { "Hindi": "देखने के लिए उपयोग की जाती हैं।", "Japanese": "見るために使うもの。" },
        "examples": [
          {
            "sentence": "She has brown eyes.",
            "translation": { "Hindi": "उसकी आंखें भूरे रंग की हैं।", "Japanese": "彼女は茶色い目をしています。" }
          }
        ]
      },
      {
        "word": "face",
        "word_translation": { "Hindi": "चेहरा", "Japanese": "顔" },
        "meaning": "The front part of your head.",
        "meaning_translation": { "Hindi": "आपके सिर का अगला हिस्सा।", "Japanese": "頭の前の部分。" },
        "examples": [
          {
            "sentence": "She has a smiling face.",
            "translation": { "Hindi": "उसका चेहरा मुस्कुराता हुआ है।", "Japanese": "彼女は笑顔の顔をしています。" }
          }
        ]
      },
      {
        "word": "beautiful",
        "word_translation": { "Hindi": "सुंदर", "Japanese": "美しい" },
        "meaning": "Very attractive. Pleasant to look at.",
        "meaning_translation": { "Hindi": "बहुत आकर्षक। देखने में अच्छा।", "Japanese": "とても魅力的で、見ていて心地よい。" },
        "examples": [
          {
            "sentence": "She has beautiful eyes.",
            "translation": { "Hindi": "उसकी आंखें सुंदर हैं।", "Japanese": "彼女は美しい目をしています。" }
          }
        ]
      },
      {
        "word": "handsome",
        "word_translation": { "Hindi": "सुंदर (लड़कों/पुरुषों के लिए)", "Japanese": "ハンサム（男性向け）" },
        "meaning": "Good-looking (used for boys or men).",
        "meaning_translation": { "Hindi": "आकर्षक (लड़कों/पुरुषों के लिए)।", "Japanese": "かっこいい（男性に使う）。" },
        "examples": [
          {
            "sentence": "He is handsome.",
            "translation": { "Hindi": "वह सुंदर है।", "Japanese": "彼はハンサムです。" }
          }
        ]
      },
      {
        "word": "smile",
        "word_translation": { "Hindi": "मुस्कान", "Japanese": "笑顔" },
        "meaning": "The expression when you are happy.",
        "meaning_translation": { "Hindi": "खुश होने पर चेहरे की अभिव्यक्ति।", "Japanese": "幸せな時の表情。" },
        "examples": [
          {
            "sentence": "He has a nice smile.",
            "translation": { "Hindi": "उसकी मुस्कान अच्छी है।", "Japanese": "彼は素敵な笑顔をしています。" }
          }
        ]
      }
    ],
    "grammar_tips": [
      {
        "title": "Using 'is' and 'has'",
        "explanation": "Use 'is' for describing, 'has' for features. Example: She is tall. She has long hair.",
        "explanation_translation": {
          "Hindi": "'is' का उपयोग वर्णन के लिए, 'has' का उपयोग विशेषताओं के लिए करें। उदाहरण: She is tall. She has long hair.",
          "Japanese": "「is」は状態の説明、「has」は特徴を表す時に使います。例：She is tall. She has long hair."
        }
      },
      {
        "title": "Adjectives before nouns",
        "explanation": "Put adjectives before nouns. Example: big eyes, short hair.",
        "explanation_translation": {
          "Hindi": "विशेषण को हमेशा संज्ञा से पहले रखें। उदाहरण: big eyes, short hair.",
          "Japanese": "形容詞は名詞の前に置きます。例：big eyes, short hair."
        }
      }
    ]
  },
