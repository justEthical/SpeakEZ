    "grammar_tips": [
      {
        "title": "Using 'my' with body parts",
        "explanation": "Use 'my' to talk about your body parts. Example: My head hurts.",
        "explanation_translation": {
          "Hindi": "अपने शरीर के अंगों के बारे में बात करने के लिए 'my' का उपयोग करें। उदाहरण: My head hurts.",
          "Japanese": "自分の体の部分について話すときは「my」を使います。例：My head hurts."
        }
      },
      {
        "title": "Singular and plural body parts",
        "explanation": "Some body parts are singular (head, nose, mouth) and some are plural (eyes, ears, hands, feet).",
        "explanation_translation": {
          "Hindi": "कुछ शरीर के अंग एकवचन हैं (सिर, नाक, मुंह) और कुछ बहुवचन हैं (आंखें, कान, हाथ, पैर)।",
          "Japanese": "体の部分には単数形（頭、鼻、口）と複数形（目、耳、手、足）があります。"
        }
      }
    ]
  },
