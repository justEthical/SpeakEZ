        "meaning_translation": {
          "Hindi": "आपके शरीर का सबसे ऊपरी भाग",
          "Japanese": "体の一番上の部分"
        },
        "examples": [
          {
            "sentence": "I have a headache.",
            "translation": {
              "Hindi": "मेरे सिर में दर्द है।",
              "Japanese": "頭が痛いです。"
            }
          }
        ]
      },
      {
