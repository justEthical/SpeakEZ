  "lesson_intro": {
    "vocabulary": [
      { "word": "routine", "meaning": "something you do regularly" },
      { "word": "usually", "meaning": "most of the time" },
      { "word": "rarely", "meaning": "not often" },
      { "word": "commute", "meaning": "travel to work or school" },
      { "word": "tidy", "meaning": "make something clean and organized" },
      { "word": "exercise", "meaning": "physical activity to stay healthy" },
      { "word": "breakfast", "meaning": "the first meal of the day" },
      { "word": "weekday", "meaning": "Monday to Friday" },
      { "word": "weekend", "meaning": "Saturday and Sunday" },
      { "word": "occasionally", "meaning": "sometimes, but not often" }
    ],
    "grammar_tips": [
      {
        "title": "Present Simple for Routines",
        "explanation": "Use the present simple tense to talk about habits: 'I get up at 7 a.m. every day.'"
      },
      {
        "title": "Frequency Adverbs",
        "explanation": "Words like always, usually, often, sometimes, rarely, and never show how often you do something. Example: 'She often goes to the gym.'"
      },
      {
        "title": "Questions about Routine",
        "explanation": "Use 'do/does' to ask about habits: 'What do you do on weekends?'"
      }
    ],
    "example_sentences": [
      {
        "sentence": "I usually wake up at 6:30 in the morning.",
