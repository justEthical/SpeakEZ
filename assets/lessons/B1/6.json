      { "word": "consider", "meaning": "to think about carefully" },
      { "word": "recommend", "meaning": "to say something is a good idea" },
      { "word": "choice", "meaning": "the thing you pick" }
    ],
    "grammar_tips": [
      {
        "title": "Expressing Preferences",
        "explanation": "Use 'prefer' or 'would rather' to say what you like. Example: I prefer tea to coffee."
      },
      {
        "title": "Giving Reasons",
        "explanation": "Use 'because' or 'so' to explain your choice. Example: I chose the red shirt because it looks nice."
      }
    ],
