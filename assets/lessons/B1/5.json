    "grammar_tips": [
      {
        "title": "Using adjectives to describe people",
        "explanation": "Put the adjective before the noun. Example: She is a creative person."
      },
      {
        "title": "Using 'very' and 'quite' for emphasis",
        "explanation": "Use 'very' or 'quite' before an adjective. Example: He is very hardworking."
      }
