  "purpose": "All",
  "cefrLevel": "B1",
  "lesson_intro": {
    "vocabulary": [
      { "word": "profession", "meaning": "a type of job that needs special training" },
      { "word": "colleague", "meaning": "a person you work with" },
      { "word": "salary", "meaning": "money you get for your work" },
      { "word": "interview", "meaning": "a meeting to get a job" },
      { "word": "promotion", "meaning": "when you move to a higher position at work" },
      { "word": "full-time", "meaning": "working all the usual hours of a job" },
      { "word": "part-time", "meaning": "working fewer hours than a full-time job" },
      { "word": "employer", "meaning": "the person or company you work for" },
      { "word": "employee", "meaning": "a person who works for someone else" },
      { "word": "responsibility", "meaning": "something you must do as part of your job" }
    ],
    "grammar_tips": [
      {
        "title": "Talking about job roles",
        "explanation": "Use 'I work as...' or 'My job is...' Example: I work as a teacher."
      },
      {
        "title": "Describing duties and responsibilities",
        "explanation": "Use 'have to' or 'must' to talk about things you need to do. Example: I have to attend meetings."
      }
    ],
    "example_sentences": [
      { "sentence": "I work as a nurse in a hospital.", "translation": "" },
      { "sentence": "My colleague is very helpful.", "translation": "" },
      { "sentence": "She got a promotion last month.", "translation": "" },
      { "sentence": "The salary for this job is good.", "translation": "" }
    ]
  },
