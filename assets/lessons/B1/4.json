    "vocabulary": [
      { "word": "problem", "meaning": "something difficult or not right" },
      { "word": "solution", "meaning": "the answer to a problem" },
      { "word": "fix", "meaning": "to repair or solve something" },
      { "word": "suggestion", "meaning": "an idea to help someone" },
      { "word": "advice", "meaning": "what someone tells you to help you decide" },
      { "word": "trouble", "meaning": "a situation that is difficult or has problems" },
      { "word": "complain", "meaning": "to say you are not happy about something" },
      { "word": "recommend", "meaning": "to say something is a good idea" },
      { "word": "deal with", "meaning": "to try to solve or manage a problem" },
      { "word": "improve", "meaning": "to make something better" }
    ],
    "grammar_tips": [
      {
        "title": "Making suggestions",
        "explanation": "Use 'You should...' or 'Why don't you...?' to give ideas. Example: You should talk to your boss."
      },
      {
        "title": "Talking about problems in the past",
        "explanation": "Use the past simple for finished problems. Example: I had a problem with my laptop last week."
      }
    ],
